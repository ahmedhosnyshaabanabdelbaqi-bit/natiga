APP_NAME="EV Community Egypt"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL is the only supported production database
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ev_community
DB_USERNAME=ev
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email (EmailProvider). Set MAIL_MAILER=smtp (or another Laravel mailer) with
# real credentials to activate the email channel; "log" keeps it Not Configured.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage (private documents). Leave empty to use local storage.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Maps (MapProvider). osm = OpenStreetMap tiles (no key). google|mapbox need keys.
# Only MAP_PUBLIC_KEY is ever sent to the browser.
# ---------------------------------------------------------------------------
MAP_PROVIDER=osm
MAP_PUBLIC_KEY=
MAP_SERVER_KEY=
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_DEFAULT_LAT=30.0444
MAP_DEFAULT_LNG=31.2357
MAP_DEFAULT_ZOOM=7

# ---------------------------------------------------------------------------
# Optional integrations — "none"/"manual" keeps them Not Configured (never fake success)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SHIPPING_PROVIDER=manual
SHIPPING_API_KEY=

CHARGING_PROVIDER=none
CHARGING_API_KEY=

EXCHANGE_RATE_PROVIDER=manual
EXCHANGE_RATE_API_KEY=

SEARCH_DRIVER=database

# Security headers: strict Content-Security-Policy (nonce based) — enabled automatically in production
EV_CSP_ENABLED=false
EV_CSP_CONNECT_HOSTS=

# Demo data is never generated in production unless this is explicitly true
EV_ALLOW_DEMO_DATA_IN_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
