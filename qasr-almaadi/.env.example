# Reference only: set these variables in the process environment.
HOST=127.0.0.1
PORT=4310
DATA_DIR=./data/local
# One-time offline setup via npm run setup:
# HOSPITAL_NAME=Your hospital
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=provide-a-unique-secret-of-at-least-16-characters
# Optional external database (not required for PGlite):
# DATABASE_URL=postgresql://user:password@localhost:5432/child
# SESSION_SECURE=true
# TRUST_PROXY=loopback
# Isolated demo preview only; never enable on a live hospital database:
# SEED_DEMO_DATA=true
