# ---- إعدادات التشغيل بـ Docker Compose ----

# مفتاح التطبيق: ولّده بـ  docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_URL=http://localhost:8000

# قاعدة البيانات
DB_DATABASE=eg_erp
DB_USERNAME=erp
DB_PASSWORD=          # مطلوب — استخدم كلمة مرور قوية
DB_PORT=5432

# المنافذ
API_PORT=8000
WEB_PORT=8080

# عنوان API كما يراه المتصفح.
# اتركه /api/v1 ليمرّره Nginx داخليًا إلى الخادم — يعمل مع أي نطاق أو IP
# دون إعادة بناء الواجهة ودون إعدادات CORS.
VITE_API_BASE=/api/v1

# هوية النظام — قابلة للتغيير من الإعدادات بعد التثبيت
ERP_SYSTEM_NAME=محمد فياض
ERP_COMPANY_NAME=محمد فياض للتوزيع

# مفتاح تشفير النسخ الاحتياطية — احفظه خارج الخادم
ERP_BACKUP_KEY=

# كلمة مرور المدير عند التثبيت. اتركها فارغة ليولّدها النظام ويعرضها مرة واحدة.
ERP_ADMIN_PASSWORD=
