# المجدول — النسخ الاحتياطية اليومية وتنظيف الحجوزات ومؤشرات الاستثناءات.
# انسخه إلى /etc/systemd/system/erp-scheduler.service ثم:
#   systemctl daemon-reload && systemctl enable --now erp-scheduler

[Unit]
Description=محمد فياض ERP — المهام المجدولة
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mohamed-fayad-erp/backend
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
StandardOutput=append:/var/log/erp/scheduler.log
StandardError=append:/var/log/erp/scheduler.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
