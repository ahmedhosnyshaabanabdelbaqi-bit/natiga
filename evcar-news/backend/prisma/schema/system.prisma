// Audit, import jobs, unified search index, statistics
// (modules: audit, system, search, home).

enum ImportJobStatus {
  pending
  validating
  /// Validated (dry run / preview) and waiting for confirmation.
  ready
  running
  completed
  completed_with_errors
  failed
  cancelled

  @@map("import_job_status")
}

enum ImportRowStatus {
  pending
  valid
  invalid
  imported
  updated
  skipped
  duplicate
  failed

  @@map("import_row_status")
}

enum SearchEntityType {
  article
  brand
  model
  variant
  station
  encyclopedia
  tour
  service_provider

  @@map("search_entity_type")
}

/// Every mutating admin request (actor, action, entity, before/after, ip,
/// userAgent, requestId). Append-only.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Snapshot of the actor's e-mail/label at the time of the action.
  actorLabel String?  @map("actor_label") @db.VarChar(320)
  /// e.g. "articles.publish", "settings.update".
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  diff       Json?
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

/// CSV imports, provider syncs (OCM), RSS fetch runs...
model ImportJob {
  id            String          @id @default(uuid(7)) @db.Uuid
  /// e.g. "vehicles.csv", "prices.csv", "stations.csv", "stations.ocm_sync", "rss.fetch".
  type          String          @db.VarChar(64)
  status        ImportJobStatus @default(pending)
  source        String?         @db.VarChar(500)
  fileAssetId   String?         @map("file_asset_id") @db.Uuid
  options       Json            @default("{}")
  dryRun        Boolean         @default(false) @map("dry_run")
  totalRows     Int             @default(0) @map("total_rows")
  processedRows Int             @default(0) @map("processed_rows")
  successRows   Int             @default(0) @map("success_rows")
  errorRows     Int             @default(0) @map("error_rows")
  skippedRows   Int             @default(0) @map("skipped_rows")
  error         String?
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  fileAsset MediaAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  rows      ImportJobRow[]

  @@index([type, createdAt(sort: Desc)])
  @@index([status])
  @@map("import_jobs")
}

model ImportJobRow {
  id         String          @id @default(uuid(7)) @db.Uuid
  jobId      String          @map("job_id") @db.Uuid
  rowNumber  Int             @map("row_number")
  status     ImportRowStatus @default(pending)
  data       Json
  /// [{field, code, message}]
  errors     Json?
  entityType String?         @map("entity_type") @db.VarChar(64)
  entityId   String?         @map("entity_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@map("import_job_rows")
}

/// Unified search index across entity types, one row per entity × locale.
/// Owning modules upsert rows when content is published/changed (and delete
/// or unpublish them when it is unpublished/deleted). The normalized_*
/// columns and search_vector are maintained by a trigger using
/// app_normalize_text() (same rules as src/common/i18n/arabic-normalize.ts).
/// `marketCodes` = markets where the entity is visible (article_markets,
/// variant_markets...); EMPTY = all markets. Filter with
/// `cardinality(market_codes) = 0 OR $market = ANY(market_codes)` (GIN index).
model SearchDocument {
  id              String                   @id @default(uuid(7)) @db.Uuid
  entityType      SearchEntityType         @map("entity_type")
  entityId        String                   @map("entity_id") @db.Uuid
  locale          String                   @db.VarChar(10)
  /// Empty = all markets.
  marketCodes     String[]                 @default([]) @map("market_codes") @db.VarChar(8)
  title           String                   @db.VarChar(500)
  subtitle        String?                  @db.VarChar(500)
  body            String?
  /// Extra keywords (aliases, codes) that should match but are not displayed.
  keywords        String?
  slug            String?                  @db.VarChar(200)
  imageUrl        String?                  @map("image_url") @db.VarChar(2048)
  isPublished     Boolean                  @default(false) @map("is_published")
  boost           Float                    @default(1)
  publishedAt     DateTime?                @map("published_at") @db.Timestamptz(3)
  normalizedTitle String?                  @map("normalized_title")
  normalizedText  String?                  @map("normalized_text")
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entityType, entityId, locale])
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "search_documents_normalized_title_trgm")
  @@index([searchVector], type: Gin, map: "search_documents_search_vector_gin")
  @@index([entityType, isPublished])
  @@index([marketCodes], type: Gin, map: "search_documents_market_codes_gin")
  @@map("search_documents")
}

/// Alternative spellings / transliterations, e.g. "بي واي دي" ↔ "BYD" (they
/// are spellings, not facts). term_normalized / canonical_normalized are
/// maintained by trigger. Optional binding to one entity (entityType +
/// entityId, both or neither — CHECK; no FK because the target table varies).
/// `isSystem` rows come from the reference seed, which re-creates missing
/// ones on every deploy: admins deactivate them (isActive = false) instead of
/// deleting or renaming them. Only active aliases are used for search.
model SearchAlias {
  id                  String            @id @default(uuid(7)) @db.Uuid
  term                String            @db.VarChar(200)
  canonical           String            @db.VarChar(200)
  termNormalized      String?           @map("term_normalized") @db.VarChar(200)
  canonicalNormalized String?           @map("canonical_normalized") @db.VarChar(200)
  locale              String?           @db.VarChar(10)
  entityType          SearchEntityType? @map("entity_type")
  entityId            String?           @map("entity_id") @db.Uuid
  isActive            Boolean           @default(true) @map("is_active")
  isSystem            Boolean           @default(false) @map("is_system")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([term, canonical])
  @@index([termNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "search_aliases_term_trgm")
  @@index([canonicalNormalized])
  @@index([entityType, entityId])
  @@map("search_aliases")
}

/// Daily aggregated counters for reports ("most read", "most compared") and
/// anonymous analytics. No per-user tracking and no browsing history: only
/// (entity, day) totals, incremented with
/// INSERT ... ON CONFLICT (entity_type, entity_id, day) DO UPDATE SET x = x + n.
/// Conventions: article → views/shares/favorites; variant → views and
/// `comparisons` (+1 per comparison created or opened that contains it);
/// comparison → views/shares.
model ContentDailyStat {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// article | brand | model | variant | comparison | tour | station | encyclopedia (CHECK)
  entityType  String   @map("entity_type") @db.VarChar(32)
  entityId    String   @map("entity_id") @db.Uuid
  day         DateTime @db.Date
  views       Int      @default(0)
  shares      Int      @default(0)
  comparisons Int      @default(0)
  favorites   Int      @default(0)

  @@unique([entityType, entityId, day])
  @@index([day, entityType])
  @@index([entityType, day])
  @@map("content_daily_stats")
}
