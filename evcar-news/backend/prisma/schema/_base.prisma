// EV Car News — Prisma schema (multi-file). See docs/decisions/backend-core.md.
//
// Conventions (binding for every file in this folder):
// - Tables and columns are snake_case via @@map / @map; Prisma fields are camelCase.
// - Primary keys: UUID v7 generated by Prisma (`@default(uuid(7)) @db.Uuid`),
//   except natural-key reference tables (markets.code, currencies.code,
//   connector_types.code, spec_definitions.key, app_settings.key).
// - Timestamps are timestamptz(3); `updatedAt` is maintained by Prisma.
// - Missing values are NULL, never 0.
// - Raw-SQL-only parts (CHECK constraints, triggers that maintain PostGIS
//   `location` and search columns, partial unique indexes) live in migrations.
//   Prisma ignores CHECKs, triggers and partial indexes when diffing, so they
//   survive future `prisma migrate dev` runs. NEVER use GENERATED columns or
//   NULLS NOT DISTINCT indexes (Prisma would try to drop/alter them).
// - `createdById` / `updatedById` columns on catalog tables are informational
//   (no FK); the authoritative trail is audit_logs.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  runtime             = "nodejs"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm, unaccent, btree_gist]
}
