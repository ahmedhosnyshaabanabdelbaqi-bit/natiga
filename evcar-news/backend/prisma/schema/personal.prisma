// Personal data: favorites, comparisons, garage, charging logs, reminders,
// trip plans (modules: favorites, comparisons, garage, charging-logs,
// reminders, trips). All rows owned by a user are hard-deleted with the user.

enum FavoriteTargetType {
  article
  model
  variant
  station
  comparison
  tour

  @@map("favorite_target_type")
}

enum ChargingLocationType {
  home
  public
  work
  other

  @@map("charging_location_type")
}

enum ReminderType {
  maintenance
  insurance
  /// Vehicle licence / registration renewal (ترخيص).
  licence
  tyres
  /// User-defined (title says what).
  custom

  @@map("reminder_type")
}

/// Exactly one target FK is set, matching target_type (CHECK).
model Favorite {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  targetType   FavoriteTargetType @map("target_type")
  articleId    String?            @map("article_id") @db.Uuid
  modelId      String?            @map("model_id") @db.Uuid
  variantId    String?            @map("variant_id") @db.Uuid
  stationId    String?            @map("station_id") @db.Uuid
  comparisonId String?            @map("comparison_id") @db.Uuid
  tourId       String?            @map("tour_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article    Article?         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  model      CarModel?        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  variant    VehicleVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  station    ChargingStation? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  comparison Comparison?      @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  tour       InteriorTour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, modelId])
  @@unique([userId, variantId])
  @@unique([userId, stationId])
  @@unique([userId, comparisonId])
  @@unique([userId, tourId])
  @@index([userId, targetType, createdAt(sort: Desc)])
  @@map("favorites")
}

/// Saved / shared comparison of 2–4 variants. `shareId` is the public short
/// id used in https://evcar.news/compare/:shareId.
/// - saved by a user: userId set (deleted with the user);
/// - anonymous share: userId NULL, isCurated false; `signature` (sha256 of the
///   ordered "variantId@market" list) lets the service reuse an identical
///   share instead of creating duplicates;
/// - curated ("مقارنات مختارة"): isCurated, no owner (CHECK), workflow status
///   in curatedStatus; published curated comparisons need titleAr + titleEn.
/// `marketCode` is the display context (currency); each item pins its own
/// market. Between 2 and 4 items at COMMIT (deferred constraint trigger).
/// `viewCount` is an anonymous counter (no per-user history).
model Comparison {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  shareId       String         @unique @map("share_id") @db.VarChar(24)
  /// User's own label.
  title         String?        @db.VarChar(200)
  /// Display titles of curated comparisons.
  titleAr       String?        @map("title_ar") @db.VarChar(200)
  titleEn       String?        @map("title_en") @db.VarChar(200)
  marketCode    String         @map("market_code") @db.VarChar(8)
  signature     String?        @db.Char(64)
  isCurated     Boolean        @default(false) @map("is_curated")
  curatedStatus ContentStatus? @map("curated_status")
  curatedOrder  Int?           @map("curated_order")
  viewCount     Int            @default(0) @map("view_count")
  lastViewedAt  DateTime?      @map("last_viewed_at") @db.Timestamptz(3)
  isDemo        Boolean        @default(false) @map("is_demo")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market           @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  items     ComparisonItem[]
  favorites Favorite[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([isCurated, curatedStatus, curatedOrder])
  @@index([signature])
  @@map("comparisons")
}

/// Each item pins variant (→ model year) + market; position 1..4 (CHECK).
/// (variant_id, market_code) must exist in variant_markets (composite FK):
/// a variant is never compared in a market it has no record for.
/// To reorder, replace the items in one transaction (position is unique).
model ComparisonItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  comparisonId String   @map("comparison_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  marketCode   String   @map("market_code") @db.VarChar(8)
  position     Int      @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comparison    Comparison     @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  variant       VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  market        Market         @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  variantMarket VariantMarket  @relation(fields: [variantId, marketCode], references: [variantId, marketCode], onDelete: Restrict)

  @@unique([comparisonId, position])
  @@unique([comparisonId, variantId, marketCode])
  @@index([variantId, marketCode])
  @@map("comparison_items")
}

/// "جراجي": a user's cars (variant + market).
model UserVehicle {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  marketCode        String    @map("market_code") @db.VarChar(8)
  nickname          String?   @db.VarChar(100)
  purchaseDate      DateTime? @map("purchase_date") @db.Date
  initialOdometerKm Decimal?  @map("initial_odometer_km") @db.Decimal(10, 1)
  /// Latest odometer reading entered by the user (km) and when it was entered.
  currentOdometerKm Decimal?  @map("current_odometer_km") @db.Decimal(10, 1)
  odometerUpdatedAt DateTime? @map("odometer_updated_at") @db.Timestamptz(3)
  isPrimary         Boolean   @default(false) @map("is_primary")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant            VehicleVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  market             Market              @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  chargingLogs       ChargingLog[]
  reminders          Reminder[]
  tripPlans          TripPlan[]
  ownerVerifications OwnerVerification[]

  /// Target of the (user_id, user_vehicle_id) composite FKs: a user's log or
  /// reminder can only point at that user's own car.
  @@unique([userId, id])
  @@index([userId])
  @@index([variantId])
  @@map("user_vehicles")
}

/// User-entered charging sessions (reports are computed from these only).
/// soc_start/soc_end are the battery % before/after (0..100, end > start when
/// both are given); cost needs its currency (CHECK).
model ChargingLog {
  id              String               @id @default(uuid(7)) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  userVehicleId   String               @map("user_vehicle_id") @db.Uuid
  stationId       String?              @map("station_id") @db.Uuid
  chargedAt       DateTime             @map("charged_at") @db.Timestamptz(3)
  energyKwh       Decimal              @map("energy_kwh") @db.Decimal(8, 3)
  cost            Decimal?             @db.Decimal(12, 2)
  currencyCode    String?              @map("currency_code") @db.Char(3)
  odometerKm      Decimal?             @map("odometer_km") @db.Decimal(10, 1)
  socStart        Decimal?             @map("soc_start") @db.Decimal(5, 2)
  socEnd          Decimal?             @map("soc_end") @db.Decimal(5, 2)
  durationMinutes Decimal?             @map("duration_minutes") @db.Decimal(8, 2)
  chargerPowerKw  Decimal?             @map("charger_power_kw") @db.Decimal(8, 2)
  /// AC or DC session when the user states it.
  currentType     CurrentType?         @map("current_type")
  locationType    ChargingLocationType @default(other) @map("location_type")
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVehicle UserVehicle      @relation(fields: [userId, userVehicleId], references: [userId, id], onDelete: Cascade)
  station     ChargingStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  currency    Currency?        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([userId, chargedAt(sort: Desc)])
  @@index([userVehicleId, chargedAt(sort: Desc)])
  @@map("charging_logs")
}

model Reminder {
  id                   String       @id @default(uuid(7)) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  userVehicleId        String?      @map("user_vehicle_id") @db.Uuid
  type                 ReminderType
  title                String       @db.VarChar(200)
  notes                String?
  dueDate              DateTime?    @map("due_date") @db.Date
  dueOdometerKm        Decimal?     @map("due_odometer_km") @db.Decimal(10, 1)
  /// Repeat after N months and/or N km (NULL = one-off).
  repeatIntervalMonths Int?         @map("repeat_interval_months")
  repeatIntervalKm     Decimal?     @map("repeat_interval_km") @db.Decimal(10, 1)
  notifyDaysBefore     Int          @default(7) @map("notify_days_before")
  /// For odometer-based reminders: notify this many km before (NULL = at due).
  notifyKmBefore       Decimal?     @map("notify_km_before") @db.Decimal(10, 1)
  lastNotifiedAt       DateTime?    @map("last_notified_at") @db.Timestamptz(3)
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVehicle UserVehicle? @relation(fields: [userId, userVehicleId], references: [userId, id], onDelete: Cascade)

  @@index([userId, completedAt, dueDate])
  @@index([dueDate])
  @@map("reminders")
}

/// Trip plans are stored ONLY when the user explicitly saves one (no
/// background location history).
model TripPlan {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  userVehicleId        String?   @map("user_vehicle_id") @db.Uuid
  variantId            String?   @map("variant_id") @db.Uuid
  title                String?   @db.VarChar(200)
  originLabel          String    @map("origin_label") @db.VarChar(300)
  originLat            Float     @map("origin_lat")
  originLng            Float     @map("origin_lng")
  destinationLabel     String    @map("destination_label") @db.VarChar(300)
  destinationLat       Float     @map("destination_lat")
  destinationLng       Float     @map("destination_lng")
  startSocPercent      Decimal   @map("start_soc_percent") @db.Decimal(5, 2)
  minArrivalSocPercent Decimal   @map("min_arrival_soc_percent") @db.Decimal(5, 2)
  /// Planned departure (used to check opening hours at the expected arrival).
  plannedDepartureAt   DateTime? @map("planned_departure_at") @db.Timestamptz(3)
  /// Visible, editable assumptions (consumption, speed factor, reserve...).
  assumptions          Json      @default("{}")
  /// Computed plan (legs, stops, energy, time, cost, confidence).
  result               Json?
  routingProvider      String?   @map("routing_provider") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVehicle UserVehicle?    @relation(fields: [userVehicleId], references: [id], onDelete: SetNull)
  variant     VehicleVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("trip_plans")
}

/// Home personalization interests (REQUIREMENTS §4): brands, models and news
/// categories the user follows. Exactly one target per row (CHECK); deleted
/// with the user or the target. Separate from notification subscriptions
/// (following ≠ being notified).
model UserInterest {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  brandId    String?  @map("brand_id") @db.Uuid
  modelId    String?  @map("model_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  model    CarModel? @relation(fields: [modelId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@unique([userId, modelId])
  @@unique([userId, categoryId])
  @@index([brandId])
  @@index([modelId])
  @@index([categoryId])
  @@map("user_interests")
}
