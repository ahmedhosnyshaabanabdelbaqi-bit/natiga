{
  "name": "evcar-news-backend",
  "version": "0.1.0",
  "description": "EV Car News backend (NestJS modular monolith, Prisma, PostgreSQL/PostGIS)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" \"*.ts\" --fix",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:check-drift": "ts-node --transpile-only src/cli/check-drift.ts",
    "db:seed": "ts-node --transpile-only src/cli/seed.ts",
    "db:seed:demo": "ts-node --transpile-only src/cli/seed-demo.ts",
    "openapi:export": "ts-node --transpile-only src/cli/openapi-export.ts",
    "create-owner": "ts-node --transpile-only src/cli/create-owner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/lib-storage": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "dotenv": "18.0.3",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.1.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "undici": "8.11.2",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.5",
    "@types/multer": "2.2.0",
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
