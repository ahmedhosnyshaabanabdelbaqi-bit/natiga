
# https://@API_DOMAIN@ → EV Car News API container (127.0.0.1:@API_PORT@).
server {
@LISTEN_443@
@HTTP2_ON@
    server_name @API_DOMAIN@;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/@CERT_NAME@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@CERT_NAME@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Resumable 360° upload chunks are at most 16 MiB (UPLOAD_CHUNK_MAX_BYTES).
    client_max_body_size @MAX_BODY_MB@m;
    client_body_timeout 300s;

    # Security headers (HSTS, CSP, nosniff...) are sent by the API itself.
    location / {
        proxy_pass http://127.0.0.1:@API_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The API trusts exactly one proxy hop (TRUST_PROXY=1): overwrite, never append.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # One-time tokens in the query string (links of e-mails / share pages): not logged.
    location ~ ^/(setup-password|reset-password|verify-email) {
        access_log off;
        proxy_pass http://127.0.0.1:@API_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Public media: any origin may load them (the app's 360° viewer uses WebGL
    # textures with crossOrigin="anonymous").
    location /media/ {
        proxy_pass http://127.0.0.1:@API_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
    }
}
