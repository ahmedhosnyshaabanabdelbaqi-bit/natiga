
# https://@ADMIN_DOMAIN@ → admin panel (127.0.0.1:@ADMIN_PORT@); /api/ → API (same origin,
# so the httpOnly refresh cookie stays first-party).
server {
@LISTEN_443@
@HTTP2_ON@
    server_name @ADMIN_DOMAIN@;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/@CERT_NAME@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@CERT_NAME@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size @MAX_BODY_MB@m;
    client_body_timeout 300s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # One-time tokens (owner setup, password reset, e-mail verification) travel
    # in the query string of these pages: they are never written to the access log.
    location ~ ^/(setup-password|reset-password|verify-email) {
        access_log off;
        proxy_pass http://127.0.0.1:@ADMIN_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:@API_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:@ADMIN_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
