# =============================================================================
# EV Car News — environment variables (every variable the backend reads).
#
# Local development: copy to backend/.env and adjust. NEVER commit real secrets.
# docker-compose.yml passes these variables to the backend container.
# Validation rules per environment live in backend/src/config/env.schema.ts
# (production refuses to start when a required value is missing or unsafe).
# Values below are local-development defaults; secrets are intentionally empty.
# =============================================================================

# --- Application ---------------------------------------------------------------
# Runtime environment. [one of: development | test | production; default: development]
NODE_ENV=development
# HTTP port. [default: 3000]
PORT=3000
# HTTP bind address. [default: 0.0.0.0]
HOST=0.0.0.0
# Public URL of this API (used to build absolute links, e.g. local media URLs). [required in: production; default: all=http://localhost:3000]
APP_PUBLIC_BASE_URL=http://localhost:3000
# Default canonical base URL for share links (overridable in app settings). [default: https://evcar.news]
SHARE_BASE_URL=https://evcar.news
# Admin panel URL (used in e-mails such as the owner password-setup link). [required in: production; default: all=http://localhost:5173]
ADMIN_BASE_URL=http://localhost:5173
# Express "trust proxy" setting: false, a hop count or a comma list of proxy subnets. MUST be set when the API runs behind nginx / the Vite dev proxy / a load balancer (e.g. 1), otherwise every client shares the proxy IP for rate limits and login lockouts. "true" (trust any X-Forwarded-For, spoofable) is refused in production. [default: false]
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS (admin panel). Empty = none. [default: development=http://localhost:5173, test=(empty), production=(empty)]
CORS_ORIGINS=http://localhost:5173
# Serve Swagger UI at /api/docs and JSON at /api/docs-json. [default: development=true, test=true, production=false]
SWAGGER_ENABLED=true
# Fallback content language when neither ?lang nor Accept-Language match. [one of: ar | en; default: ar]
DEFAULT_LANGUAGE=ar
# Fallback market code when app_settings "defaults.defaultMarket" is not set (e.g. before seeding). [default: EG]
DEFAULT_MARKET=EG

# --- Logging -------------------------------------------------------------------
# pino log level. [one of: fatal | error | warn | info | debug | trace | silent; default: development=debug, test=silent, production=info]
LOG_LEVEL=debug
# Human-readable logs (requires the pino-pretty dev dependency). [default: development=true, test=false, production=false]
LOG_PRETTY=true

# --- Database & Redis ----------------------------------------------------------
# PostgreSQL (PostGIS) connection string. [required in: development, test, production; SECRET]
DATABASE_URL=postgresql://evcar:evcar_dev_pw@localhost:5432/evcar_dev
# Max connections in the pg pool used by Prisma. [default: all=10, test=5]
DATABASE_POOL_MAX=10
# Per-statement timeout (0 = none). [default: 30000]
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Redis connection string (BullMQ, rate limiting, caches). [required in: production; SECRET; default: development=redis://localhost:6379, test=redis://localhost:6379]
REDIS_URL=redis://localhost:6379
# Prefix for all Redis keys written by the app (not BullMQ). [default: evcar:]
REDIS_KEY_PREFIX=evcar:

# --- Authentication ------------------------------------------------------------
# HMAC secret for access tokens. Required in production (>= 32 chars). In dev/test a random ephemeral secret is generated when unset. [required in: production; SECRET]
JWT_ACCESS_SECRET=
# Access token lifetime (default 15 minutes). [default: 900]
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (sliding: every refresh extends it, up to JWT_SESSION_MAX_AGE_DAYS). [default: 30]
JWT_REFRESH_TTL_DAYS=30
# Absolute maximum age of a login session in days, counted from sign-in; refreshing never extends a session beyond it. [default: 90]
JWT_SESSION_MAX_AGE_DAYS=90
# Seconds after a rotation during which the previous refresh token is still accepted (returns the same new token) so a lost response or a concurrent refresh does not sign the device out. 0 = strict. [default: 60]
AUTH_REFRESH_REUSE_GRACE_SECONDS=60
# Minimum duration of register / resend-verification / forgot-password responses, so their timing does not reveal whether an address is registered. 0 = off. [default: all=400, test=0]
AUTH_UNIFORM_RESPONSE_MS=400
# JWT "iss" claim. [default: evcar.news]
JWT_ISSUER=evcar.news
# JWT "aud" claim. [default: evcar-api]
JWT_AUDIENCE=evcar-api
# Set the Secure flag on the evcar_rt refresh cookie (web clients). [default: development=false, test=false, production=true]
AUTH_COOKIE_SECURE=false
# Lifetime of e-mail verification tokens. [default: 1440]
EMAIL_TOKEN_TTL_MINUTES=1440
# Lifetime of password reset / setup tokens. [default: 60]
PASSWORD_RESET_TTL_MINUTES=60
# Comma-separated Google OAuth client IDs accepted as ID-token audience. Empty = Google sign-in not configured (503).
GOOGLE_OAUTH_CLIENT_IDS=
# Comma-separated Apple bundle/service IDs accepted as audience. Empty = Apple sign-in not configured (503).
APPLE_OAUTH_CLIENT_IDS=
# Salt for hashing reporter IPs (abuse protection). Random in dev/test when unset. [required in: production; SECRET]
IP_HASH_SALT=

# --- Rate limiting -------------------------------------------------------------
# Where rate-limit counters are kept (use redis with >1 instance). [one of: redis | memory; default: all=redis, test=memory]
RATE_LIMIT_STORAGE=redis
# Default per-IP request budget per minute for every route. [default: 300]
RATE_LIMIT_DEFAULT_PER_MINUTE=300
# Multiplies every limit (tests use a large value; a specific test can set 1 to assert 429s). [default: all=1, test=1000]
RATE_LIMIT_MULTIPLIER=1

# --- Storage & uploads ---------------------------------------------------------
# Media storage driver. [one of: local | s3; default: local]
STORAGE_DRIVER=local
# Root directory for the local driver. [default: all=./storage, test=./storage/test]
STORAGE_LOCAL_ROOT=./storage
# Public base URL for stored files (CDN or S3 website). Empty = served by this API under /media (local driver).
STORAGE_PUBLIC_BASE_URL=
# S3-compatible endpoint (e.g. http://minio:9000). Empty = AWS.
S3_ENDPOINT=
# S3 region. [default: us-east-1]
S3_REGION=us-east-1
# S3 bucket for media.
S3_BUCKET=
# S3 access key. [SECRET]
S3_ACCESS_KEY_ID=
# S3 secret key. [SECRET]
S3_SECRET_ACCESS_KEY=
# Use path-style URLs (required by MinIO). [default: true]
S3_FORCE_PATH_STYLE=true
# Max size of a single uploaded file (default 1 GiB). [default: 1073741824]
UPLOAD_MAX_BYTES=1073741824
# Max size of one chunk of a resumable upload (default 16 MiB). [default: 16777216]
UPLOAD_CHUNK_MAX_BYTES=16777216
# Resumable upload sessions expire after this many hours. [default: 24]
UPLOAD_SESSION_TTL_HOURS=24

# --- Mail ----------------------------------------------------------------------
# console = log e-mails (dev); smtp = send via SMTP. [one of: console | smtp; default: console]
MAIL_DRIVER=console
# From header. [default: EV Car News <no-reply@evcar.news>]
MAIL_FROM="EV Car News <no-reply@evcar.news>"
# SMTP host (e.g. mailpit in compose).
SMTP_HOST=
# SMTP port. [default: 587]
SMTP_PORT=587
# Use implicit TLS (port 465). [default: false]
SMTP_SECURE=false
# SMTP username.
SMTP_USER=
# SMTP password. [SECRET]
SMTP_PASSWORD=

# --- Server-side fetch (SSRF-safe) ---------------------------------------------
# User-Agent for server-side fetches (RSS, providers). [default: EVCarNewsBot/1.0 (+https://evcar.news)]
OUTBOUND_USER_AGENT="EVCarNewsBot/1.0 (+https://evcar.news)"
# Total time limit for one server-side fetch (incl. redirects). [default: 10000]
SAFE_FETCH_TIMEOUT_MS=10000
# Max response body size for server-side fetches (default 5 MiB). [default: 5242880]
SAFE_FETCH_MAX_BYTES=5242880
# Max redirects followed (each hop is re-validated). [default: 5]
SAFE_FETCH_MAX_REDIRECTS=5

# --- Integrations (optional — empty = "not configured", the feature shows a clear state) ---
# Open Charge Map API key. [SECRET]
OCM_API_KEY=
# Open Charge Map API base URL. [default: https://api.openchargemap.io/v3]
OCM_BASE_URL=https://api.openchargemap.io/v3
# Routing provider for the trip planner (none = planner hidden). [one of: none | osrm | openrouteservice | google; default: none]
ROUTING_PROVIDER=none
# OSRM server URL (https).
OSRM_BASE_URL=
# OpenRouteService API key. [SECRET]
ORS_API_KEY=
# Google Routes API key (server key, never shipped in the app). [SECRET]
GOOGLE_ROUTES_API_KEY=
# Nominatim-compatible geocoder URL (optional).
GEOCODING_BASE_URL=
# Contact e-mail sent to the geocoder per its usage policy.
GEOCODING_EMAIL=
# Default map tile URL template (overridable in settings). [default: https://tile.openstreetmap.org/{z}/{x}/{y}.png]
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Attribution text shown with map tiles. [default: © OpenStreetMap contributors]
MAP_ATTRIBUTION="© OpenStreetMap contributors"
# Max zoom for the tile provider. [default: 19]
MAP_MAX_ZOOM=19
# Firebase project id for FCM HTTP v1.
FCM_PROJECT_ID=
# FCM service-account JSON (inline, base64, or a file path). [SECRET]
FCM_SERVICE_ACCOUNT_JSON=
# APNs auth key id.
APNS_KEY_ID=
# Apple developer team id.
APNS_TEAM_ID=
# iOS bundle id (APNs topic). [default: news.evcar.app]
APNS_BUNDLE_ID=news.evcar.app
# APNs .p8 key (inline PEM or file path). [SECRET]
APNS_PRIVATE_KEY=
# Use the production APNs endpoint. [default: false]
APNS_PRODUCTION=false
# Optional LLM for the assistant (answers only from DB content). none = disabled. [one of: none | openai_compatible | anthropic; default: none]
ASSISTANT_PROVIDER=none
# LLM API base URL.
ASSISTANT_BASE_URL=
# LLM API key. [SECRET]
ASSISTANT_API_KEY=
# LLM model id.
ASSISTANT_MODEL=

# --- Background jobs -----------------------------------------------------------
# Run BullMQ workers and schedulers in this process. [default: all=true, test=false]
JOBS_ENABLED=true
# BullMQ key prefix (isolates environments sharing one Redis). [default: evcar-bull]
BULLMQ_PREFIX=evcar-bull
