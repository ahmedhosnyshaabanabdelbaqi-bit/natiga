<?xml version="1.0" encoding="utf-8"?>
<!-- Release/profile: HTTPS only. The debug variant overrides this file
     (src/debug/res/xml) to allow the local dev API over HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
