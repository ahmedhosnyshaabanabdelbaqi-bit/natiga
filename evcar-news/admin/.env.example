# Admin panel (Vite) environment. No secrets belong here: everything prefixed
# VITE_ is embedded into the public JS bundle.

# Base URL of the API as seen by the browser. Default: same-origin "/api/v1"
# (the Vite dev server proxies /api to the backend, see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Dev-server only: where /api is proxied to (not embedded in the bundle). Read from
# the environment or from admin/.env[.local] (vite.config.ts loads it explicitly).
EVCAR_API_PROXY_TARGET=http://localhost:3000
